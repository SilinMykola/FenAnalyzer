# Gemini AI API Key (Free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom path to Stockfish binary (defaults to auto-detection on PATH or Homebrew)
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
